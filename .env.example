# ───────────────────────────── Air1 Tickets ─────────────────────────────
# Copy this file to .env.local and fill in the values you have.
# Everything is optional: with no values set the site runs fully in demo
# mode (mock flight inventory, simulated payments, local SQLite database).

# ── App ──────────────────────────────────────────────────────────────────
# Public canonical origin (no trailing slash). Used for SEO metadata,
# sitemaps, canonical URLs and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ random characters. Signs login sessions and booking-management links.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# ── Database (libSQL / Turso) ────────────────────────────────────────────
# Default is a local SQLite file. For production use Turso (or any libSQL
# server): set DATABASE_URL=libsql://<db>-<org>.turso.io and the auth token.
DATABASE_URL=file:./data/air1.db
DATABASE_AUTH_TOKEN=

# ── Flight inventory provider ────────────────────────────────────────────
# "mock"   – realistic simulated inventory (default, no key required)
# "duffel" – live inventory & ticketing via Duffel (https://duffel.com)
FLIGHT_PROVIDER=mock
DUFFEL_ACCESS_TOKEN=

# ── Payments (Stripe) ────────────────────────────────────────────────────
# Leave empty to use the built-in demo checkout (no real charges).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Transactional email (Resend) ─────────────────────────────────────────
# Leave empty to log emails to the server console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Air1 Tickets <bookings@air1tickets.com>"

# ── Fees ─────────────────────────────────────────────────────────────────
# Optional Air1 service fee per paying passenger, in USD (0 = no booking fees).
NEXT_PUBLIC_SERVICE_FEE_PER_PASSENGER=0

# ── Conversion model ─────────────────────────────────────────────────────
# "lead" (default): travelers lock a fare and talk to an agent on WhatsApp /
# Messenger / phone who sends a last-minute deal; the site takes no payment.
# "checkout": the full self-service booking + payment flow.
NEXT_PUBLIC_BOOKING_MODE=lead
# What the Search button does. "whatsapp" (default): opens WhatsApp with the
# traveler's whole request typed out. "results": shows the on-site results page.
NEXT_PUBLIC_SEARCH_MODE=whatsapp
# Set to 1 only if the host serves pages at /path/ instead of /path (Next's
# trailingSlash). Keeps canonical URLs, Open Graph URLs and the sitemap in step.
NEXT_PUBLIC_TRAILING_SLASH=
# WhatsApp Business number (any format; digits are extracted) and the Facebook
# Page username used for m.me links. Optional Telegram username without @.
NEXT_PUBLIC_WHATSAPP_NUMBER=+1 942-338-2017
NEXT_PUBLIC_WHATSAPP_DISPLAY=+1 (942) 338-2017
NEXT_PUBLIC_MESSENGER_PAGE=air1tickets
NEXT_PUBLIC_TELEGRAM_USERNAME=
# How long a locked fare is honored, and the promised first-response time.
NEXT_PUBLIC_PRICE_LOCK_HOURS=48
NEXT_PUBLIC_LOCK_RESPONSE_MINUTES=15
# Where new leads (fare locks) are emailed, and who may open /admin/leads
# (comma-separated account emails; accounts with role "admin" always can).
LEADS_EMAIL=
ADMIN_EMAILS=

# ── Company details shown on the site ────────────────────────────────────
NEXT_PUBLIC_SUPPORT_PHONE=+1 (942) 338-2017
NEXT_PUBLIC_SUPPORT_EMAIL=support@air1tickets.com

# ── SEO / analytics (optional) ───────────────────────────────────────────
# Google Analytics 4. Conversions are tracked as the "request_sent" event —
# mark it as a key event in GA4 so it can be imported into Google Ads.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook/Instagram) Pixel. Sends Lead and Contact events. Only loads
# after the visitor accepts cookies.
NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity — free session recordings and heatmaps. Consent-gated too.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Search engine ownership verification.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
